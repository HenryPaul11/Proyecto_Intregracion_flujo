@{
    var success = TempData["Exito"] as string;
    var failure = TempData["Error"] as string;
    var errors = ViewData.ModelState.Values.SelectMany(value => value.Errors).Select(error => string.IsNullOrWhiteSpace(error.ErrorMessage) ? "Revise los datos ingresados." : error.ErrorMessage).Distinct().ToList();
    if (!string.IsNullOrWhiteSpace(failure)) errors.Insert(0, failure);
}
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="notifications">
@if (!string.IsNullOrWhiteSpace(success))
{
<div class="toast app-toast toast-success show" role="status" aria-live="polite" aria-atomic="true" data-app-toast="success"><div class="toast-header"><strong class="me-auto">Operación completada</strong><button type="button" class="toast-close" data-bs-dismiss="toast" aria-label="Cerrar aviso">×</button></div><div class="toast-body">@success</div></div>
}
@if (errors.Count > 0)
{
<div class="toast app-toast toast-error show" role="alert" aria-live="assertive" aria-atomic="true" data-app-toast="error"><div class="toast-header"><strong class="me-auto">Revise la información</strong><button type="button" class="toast-close" data-bs-dismiss="toast" aria-label="Cerrar aviso">×</button></div><div class="toast-body"><ul class="mb-0 ps-3">@foreach (var message in errors) { <li>@message</li> }</ul></div></div>
}
</div>
