<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Sakila</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
<div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SAKILA <small class="fw-normal">/ cine en casa</small></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir navegación"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav me-auto">
        @if (Context.Session.GetInt32("UsuarioId").HasValue)
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Peliculas" asp-action="Index">Catálogo</a></li>
            @if (Context.Session.GetString("Rol") == "Cliente")
            { <li class="nav-item"><a class="nav-link" asp-controller="Alquileres" asp-action="Index">Mis alquileres</a></li> }
            @if (Context.Session.GetString("Rol") == "Administrador")
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Peliculas" asp-action="Administrar">Administración</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Alquileres" asp-action="Todos">Alquileres</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="PeliculasMasAlquiladas">Reporte</a></li>
            }
        }
        </ul>
        @if (Context.Session.GetInt32("UsuarioId").HasValue)
        {
            <span class="text-white small me-3">@Context.Session.GetString("Nombre") · @Context.Session.GetString("Rol")</span>
            <form asp-controller="Cuenta" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Cerrar sesión</button></form>
        }
        else { <a class="btn btn-outline-light btn-sm" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a> }
    </div>
</div>
</nav>
</header>
<main class="container pb-5">
    <partial name="_Mensajes" />
    @RenderBody()
</main>
<footer class="border-top py-3 text-muted"><div class="container small">Sakila · Sistema de renta de películas · ASP.NET Core MVC</div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
