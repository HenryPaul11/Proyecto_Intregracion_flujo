@model LoginModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="row justify-content-center py-5"><div class="col-md-5">
    <div class="card shadow-sm"><div class="card-body p-4">
        <p class="text-uppercase text-muted small">Sakila · Renta de películas</p>
        <h1 class="h3 mb-3">Iniciar sesión</h1>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Login" class="form-label"></label><input asp-for="Login" class="form-control" autocomplete="username" /><span asp-validation-for="Login" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <button class="btn btn-primary w-100">Ingresar</button>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
