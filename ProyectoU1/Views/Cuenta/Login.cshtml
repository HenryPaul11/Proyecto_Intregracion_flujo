@model LoginModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="login-shell">
    <section class="login-story"><p class="eyebrow">BIENVENIDO A SAKILA</p><h2>El cine se vive.<br>Las historias<br>se quedan.</h2><p>Tu colección de películas, tus próximas favoritas y todas esas historias que merecen otra noche.</p><div class="login-emblem" aria-hidden="true">S<span>◉</span></div><span class="login-footnote">CINE EN CASA. HISTORIAS SIN LÍMITES.</span></section>
    <div class="login-form-panel">
    <div class="card shadow-sm"><div class="card-body p-4">
        <p class="text-uppercase text-muted small">Sakila · Renta de películas</p>
        <h1 class="h3 mb-3">Iniciar sesión</h1>
        <p class="text-muted mb-4">Qué bueno verte de nuevo. Tu próxima historia te espera.</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Login" class="form-label"></label><input asp-for="Login" class="form-control" autocomplete="username" /><span asp-validation-for="Login" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <button class="btn btn-primary w-100">Ingresar</button>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
