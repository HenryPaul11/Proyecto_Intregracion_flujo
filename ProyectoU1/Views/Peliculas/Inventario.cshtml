@model InventarioModel
@{ ViewData["TablePage"] = true; }
@{ ViewData["Title"] = "Inventario"; }
<a asp-action="Administrar">← Administración</a>
<h1 class="mt-3">Copias de @Model.Pelicula.Titulo</h1>
<partial name="_Disponibilidad" model="Model.Pelicula" />
@if (Model.Pelicula.Activo)
{
    <form asp-action="AgregarCopia" method="post" class="d-flex gap-2 align-items-end my-4">
        <input type="hidden" name="id" value="@Model.Pelicula.Id" />
        <div><label for="tiendaId" class="form-label">Tienda</label><select name="tiendaId" id="tiendaId" class="form-select">@foreach (var store in Model.Tiendas) { <option value="@store.Id">@store.Nombre</option> }</select></div>
        <button class="btn btn-primary">Agregar copia</button>
    </form>
}
<div tabindex="0" role="region" aria-label="Tabla de copias" class="table-responsive mt-4"><table class="table table-striped align-middle"><thead><tr><th>Copia</th><th>Tienda</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
@foreach (var copy in Model.Copias)
{
    <tr><td>@copy.Id</td><td>@copy.TiendaId</td><td>@(!copy.Activa ? "Retirada" : copy.Alquilada ? "Alquilada" : "Disponible")</td><td>
    @if (copy.Activa && !copy.Alquilada)
    { <form asp-action="RetirarCopia" method="post"><input type="hidden" name="id" value="@Model.Pelicula.Id" /><input type="hidden" name="copiaId" value="@copy.Id" /><button class="btn btn-outline-danger btn-sm">Retirar copia</button></form> }
    </td></tr>
}
</tbody></table></div>
@if (Model.Copias.Count == 0) { <p>No hay copias registradas. Agrega una para permitir el alquiler.</p> }
<nav class="d-flex gap-2 my-3" aria-label="Páginas de inventario">
    <span class="pagination-label">Página @Model.Pagina · @Model.Copias.Count copias</span>
    @if (Model.Pagina > 1) { <a class="btn btn-outline-secondary" asp-action="Inventario" asp-route-id="@Model.Pelicula.Id" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a> }
    @if (Model.HayMas) { <a class="btn btn-outline-secondary" asp-action="Inventario" asp-route-id="@Model.Pelicula.Id" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a> }
</nav>
