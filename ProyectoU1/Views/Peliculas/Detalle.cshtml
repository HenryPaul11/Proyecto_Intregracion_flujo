@model Pelicula
@{ ViewData["Title"] = Model.Titulo; }
<a asp-action="Index">← Volver al catálogo</a>
<article class="card my-4"><div class="card-body p-4">
    <p class="text-muted">@Model.Anio · @Model.Clasificacion · @Model.Duracion min</p>
    <h1>@Model.Titulo</h1><p class="lead">@Model.Descripcion</p>
    <partial name="_Disponibilidad" model="Model" />
    <p class="mt-3">Tarifa: <strong>$@Model.Tarifa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</strong> por @Model.DuracionAlquiler días.</p>
    @if (Context.Session.GetString("Rol") == "Cliente" && Model.Activo && Model.Disponibles > 0)
    {
        <form asp-controller="Alquileres" asp-action="Alquilar" method="post"><input type="hidden" name="peliculaId" value="@Model.Id" /><button class="btn btn-primary">Alquilar una copia</button></form>
        <p class="small text-muted mt-2">La copia se asignará automáticamente a tu cuenta.</p>
    }
    @if (Context.Session.GetString("Rol") == "Administrador")
    { <a class="btn btn-outline-primary" asp-action="Editar" asp-route-id="@Model.Id">Editar película</a><a class="btn btn-outline-secondary ms-2" asp-action="Inventario" asp-route-id="@Model.Id">Gestionar copias</a> }
</div></article>
