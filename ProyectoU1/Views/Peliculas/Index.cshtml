@model CatalogoModel
@{ ViewData["Title"] = Model.Administracion ? "Administración" : "Catálogo"; ViewData["TablePage"] = true; }
<div class="collection-heading"><div><p class="eyebrow">SAKILA / COLECCIÓN DE CINE</p><h1>@ViewData["Title"]<span class="collection-count">@Model.Total películas</span></h1></div>
@if (Model.Administracion) { <a class="btn btn-primary" asp-action="Crear">+ Nueva película</a> }
</div>
<form method="get" class="row g-2 catalog-search" asp-action="@(Model.Administracion ? "Administrar" : "Index")">
    <div class="col-sm-8"><label for="buscar" class="visually-hidden">Buscar por título</label><input id="buscar" name="buscar" value="@Model.Buscar" maxlength="255" placeholder="Buscar por título…" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-dark">Buscar</button></div>
</form>
<div class="table-responsive catalog-table" tabindex="0" role="region" aria-label="Catálogo de películas">
<table class="table table-striped align-middle">
<thead><tr><th>Película</th><th>Año</th><th>Clasificación</th><th>Duración</th><th>Tarifa</th><th>Disponibilidad</th><th>Acciones</th></tr></thead>
<tbody>
@foreach (var film in Model.Peliculas)
{
    <tr><td><a class="film-table-title" asp-action="Detalle" asp-route-id="@film.Id">@film.Titulo</a></td><td>@film.Anio</td><td><span class="badge bg-secondary">@film.Clasificacion</span></td><td>@film.Duracion min</td><td>$@film.Tarifa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</td><td><partial name="_Disponibilidad" model="film" /></td>
    <td><div class="table-actions">
        <a class="btn btn-outline-primary btn-sm" asp-action="Detalle" asp-route-id="@film.Id">Detalle</a>
        @if (Model.Administracion)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Editar" asp-route-id="@film.Id">Editar</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Inventario" asp-route-id="@film.Id">Copias</a>
            <form asp-action="CambiarEstado" method="post"><input type="hidden" name="id" value="@film.Id" /><input type="hidden" name="activo" value="@((!film.Activo).ToString())" /><button class="btn btn-sm @(film.Activo ? "btn-outline-danger" : "btn-outline-success")">@(film.Activo ? "Desactivar" : "Reactivar")</button></form>
        }
    </div></td></tr>
}
@if (Model.Peliculas.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-5">No se encontraron películas.</td></tr> }
</tbody></table></div>
<nav class="d-flex gap-2 my-3" aria-label="Páginas del catálogo">
    <span class="pagination-label">Página @Model.Pagina de @Model.Paginas · @Model.Total películas</span>
    @if (Model.Pagina > 1) { <a class="btn btn-outline-secondary" asp-action="@(Model.Administracion ? "Administrar" : "Index")" asp-route-buscar="@Model.Buscar" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a> }
    @for (var pageNumber = Math.Max(1, Model.Pagina - 2); pageNumber <= Math.Min(Model.Paginas, Model.Pagina + 2); pageNumber++)
    {
        <a class="btn @(pageNumber == Model.Pagina ? "btn-primary" : "btn-outline-secondary")" aria-label="Página @pageNumber" aria-current="@(pageNumber == Model.Pagina ? "page" : null)" asp-action="@(Model.Administracion ? "Administrar" : "Index")" asp-route-buscar="@Model.Buscar" asp-route-pagina="@pageNumber">@pageNumber</a>
    }
    @if (Model.Pagina < Model.Paginas) { <a class="btn btn-outline-secondary" asp-action="@(Model.Administracion ? "Administrar" : "Index")" asp-route-buscar="@Model.Buscar" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a> }
</nav>
